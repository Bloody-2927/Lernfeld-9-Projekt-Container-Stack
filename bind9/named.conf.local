zone "kopernikus-lab.lokal" {
    type master;
    file "/etc/bind/zones/db.kopernikus-lab.lokal";
};

// Rückwärtszonen (PTR)
zone "20.20.10.in-addr.arpa"  { type master; file "/etc/bind/zones/db.10.20.20"; };
zone "30.20.10.in-addr.arpa"  { type master; file "/etc/bind/zones/db.10.20.30"; };
zone "40.20.10.in-addr.arpa"  { type master; file "/etc/bind/zones/db.10.20.40"; };
zone "50.20.10.in-addr.arpa"  { type master; file "/etc/bind/zones/db.10.20.50"; };
zone "60.20.10.in-addr.arpa"  { type master; file "/etc/bind/zones/db.10.20.60"; };
zone "10.168.192.in-addr.arpa" { type master; file "/etc/bind/zones/db.192.168.10"; };
